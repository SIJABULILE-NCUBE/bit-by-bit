# I copy this file to server/.env and fill in my own values (never commit .env!)
SUPABASE_URL=
# The service role key skips RLS, so it only ever lives on the server
SUPABASE_SERVICE_ROLE_KEY=
# I use this to verify the user's login token on every request
SUPABASE_JWT_SECRET=
# My React app's address, so CORS lets it talk to the server
CLIENT_URL=
PORT=4000
